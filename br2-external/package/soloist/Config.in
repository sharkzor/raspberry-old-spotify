config BR2_PACKAGE_SOLOIST
	bool "soloist"
	depends on BR2_arm
	depends on BR2_ARM_EABIHF
	depends on BR2_TOOLCHAIN_USES_GLIBC # needs GLIBC_2.38 symbols
	depends on BR2_PACKAGE_PULSEAUDIO_HAS_ATOMIC # PulseAudio's own requirements,
	depends on BR2_USE_MMU                       # which select does not carry over
	depends on BR2_USE_WCHAR
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_PULSEAUDIO
	select BR2_PACKAGE_PULSEAUDIO_DAEMON
	help
	  Spotify Soloist: Spotify Connect client (prebuilt, proprietary).
	  Plays through PulseAudio. Builds expire 90 days after they are
	  made, and the binary may not be redistributed.

	  https://developer.spotify.com/documentation/soloist
